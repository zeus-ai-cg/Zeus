# ------------------------------------------------------------------
# Zeus AI - environment template. NAMES ONLY - never put real secret
# values in this committed file. Copy to .env and fill values there.
# SECURITY: the desktop installer needs NONE of these secrets (it is a
# hosted-site shell). Server secrets live ONLY in Vercel + local .env.
# ------------------------------------------------------------------

# -- Supabase (required) -------------------------------------------
# Dashboard > Project Settings > API. Publishable/anon key is safe to
# expose (acts under RLS). Service role bypasses RLS - server only!
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# -- AI provider keys (server-side only) ---------------------------
# Gemini is the classic fallback; others power the multi-provider
# catalog and the voice transcription chain.
GEMINI_API_KEY=""
GROQ_API_KEY=""
DEEPSEEK_API_KEY=""
CEREBRAS_API_KEY=""
QWEN_API_KEY=""
MISTRAL_API_KEY=""
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_KEY=""

# -- Voice transcription chain (optional) --------------------------
# Order: Groq -> Gemini -> Mistral -> Cerebras(skip) -> Cloudflare.
# Leave blank to skip a provider. All empty = voice disabled (503).
# Optional model overrides:
SPEECH_TO_TEXT_MODEL=""
GEMINI_STT_MODEL=""
MISTRAL_STT_MODEL=""
CLOUDFLARE_STT_MODEL=""

# -- Site URL (SEO/canonical/OAuth redirects) ----------------------
VITE_SITE_URL="https://zeusai.website"

# -- Lemon Squeezy billing -----------------------------------------
# Public checkout links (client-safe):
VITE_LEMONSQUEEZY_PRO_CHECKOUT_URL=""
VITE_LEMONSQUEEZY_ULTIMATE_CHECKOUT_URL=""
# Store/product configuration (server):
LEMONSQUEEZY_STORE_ID=""
LEMONSQUEEZY_PRO_VARIANT_ID=""
LEMONSQUEEZY_ULTIMATE_VARIANT_ID=""
# Secrets (server only - NEVER expose):
LEMONSQUEEZY_API_KEY=""
LEMONSQUEEZY_WEBHOOK_SECRET=""

# -- BYOK key encryption (required for saved user API keys) --------
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Rotating it makes previously saved BYOK keys undecryptable.
API_KEY_ENCRYPTION_SECRET=""

# -- Ox Alpha (default platform AI via gateway) --------------------
OxALPHA_API_KEY=""
OXALPHA_MODEL="stealth/ox-alpha"

# -- Product releases (download page + update feeds) ---------------
# Use stable github.com/.../releases/download/... permalinks (canonical
# repo: zeus-ai-cg/Zeus). Keep versions in sync with actual uploads.
ZEUS_DESKTOP_SETUP_URL=""
ZEUS_DESKTOP_VERSION="1.5.1"
ZEUS_VSIX_URL=""
ZEUS_VSIX_VERSION="0.4.0"
