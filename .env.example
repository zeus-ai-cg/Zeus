# ── Supabase (required) ──────────────────────────────────────────────
# Project settings → API. The "publishable"/anon key is safe to expose to the
# browser; it only ever acts under Row Level Security.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"

# Same values, exposed to the client bundle via Vite (must be prefixed VITE_).
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"

# Optional, informational only — not read by any server code directly.
VITE_SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_PROJECT_ID="your-project-ref"

# Required for the Paddle webhook handler (src/routes/api/webhooks/paddle.ts),
# which is the only code path allowed to set a user's plan to "pro" — it
# needs to bypass RLS to do so. NEVER expose this key to the client.
SUPABASE_SERVICE_ROLE_KEY="service_role_xxx"

# ── Gemini (required) ────────────────────────────────────────────────
# Google AI Studio → Get API key. Used server-side only (src/routes/api/chat.ts).
GEMINI_API_KEY="your-gemini-api-key"

# ── SEO / canonical domain (recommended) ─────────────────────────────
# Used for canonical links, OpenGraph/Twitter tags, sitemap.xml, and
# robots.txt. Set this to your real production domain once you have one
# (e.g. https://zeusai.website or your Vercel domain). No trailing slash.
VITE_SITE_URL="https://zeusai.website"

# ── Lemon Squeezy billing (optional) ─────────────────────────────────
# Leave blank to disable the "Upgrade to Pro" checkout button; the app runs
# fine without these, users just can't complete a real payment.
#
# Lemon Squeezy dashboard → Products → your Pro variant → Share → copy the
# checkout link (looks like https://your-store.lemonsqueezy.com/checkout/buy/xxxxxxxx-xxxx-...).
VITE_LEMONSQUEEZY_PRO_CHECKOUT_URL="https://your-store.lemonsqueezy.com/checkout/buy/xxxxxxxx"
# Optional — Zeus Ultimate ($10/mo, Feature 7). Leave blank and the
# Ultimate checkout button stays disabled until this URL is configured.
VITE_LEMONSQUEEZY_ULTIMATE_CHECKOUT_URL="https://your-store.lemonsqueezy.com/checkout/buy/yyyyyyyy"

# Lemon Squeezy dashboard → Settings → Webhooks → your webhook → "Signing
# secret". Required for src/routes/api/webhooks.ts to verify incoming
# events; without it, Pro/Ultimate can never actually activate after a
# real payment, and the endpoint rejects every request outright.
LEMONSQUEEZY_WEBHOOK_SECRET="whsec_xxx"
# The numeric store ID and product variant IDs used by the server-side
# checkout creation route. These are required for the real checkout flow to
# work; the checkout URLs above are only a fallback if the SDK cannot create
# a checkout directly.
LEMONSQUEEZY_STORE_ID=""
LEMONSQUEEZY_PRO_VARIANT_ID=""
LEMONSQUEEZY_ULTIMATE_VARIANT_ID=""
# Backward-compatible names used by the webhook and checkout route.
LEMONSQUEEZY_VARIANT_ID_PRO=""
LEMONSQUEEZY_VARIANT_ID_ULTIMATE=""
# Optional — a Lemon Squeezy API key (dashboard → Settings → API).
# Without it, "Cancel subscription" in Billing still downgrades the
# account locally, but doesn't stop Lemon Squeezy from actually charging
# the card next cycle — set this so cancellation is real.
LEMONSQUEEZY_API_KEY=""

# ── BYOK API key encryption (required for Multi-Model Support) ───────
# Used server-side only (src/lib/crypto.server.ts) to encrypt/decrypt
# user-supplied API keys (OpenAI, Claude, OpenRouter, Groq, DeepSeek,
# Mistral, or a personal Gemini key) before/after they're stored in
# workspace's user_api_keys table. Any long random string works — generate
# one with `openssl rand -base64 32`. Changing this after keys have been
# saved makes existing saved keys undecryptable, so treat it like any other
# production secret and back it up.
API_KEY_ENCRYPTION_SECRET="change-me-to-a-long-random-string"
